{
  "name": "lct-route-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write server src tests scripts docs README.md package.json",
    "format:check": "prettier --check server src tests scripts docs README.md package.json",
    "data:geocode": "node scripts/geocode.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "prettier": "^3.9.7",
    "vite": "^6.3.0"
  }
}
